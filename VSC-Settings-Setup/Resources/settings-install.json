{
    "workbench.iconTheme": "vscode-icons",
    "workbench.startupEditor": "none",
    "workbench.tree.enableStickyScroll": false,
    "window.dialogStyle": "custom",
    "window.controlsStyle": "custom",
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "files.autoSave": "afterDelay",
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.associations": {
        "*.xlf": "plaintext",
        "*.DotSettings": "xml"
    },
    "editor.bracketPairColorization.enabled": true,
    "editor.mouseWheelZoom": true,
    "editor.linkedEditing": true,
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.tabCompletion": "on",
    "editor.stickyScroll.enabled": false,
    "editor.codeActionsOnSave": {
        "source.fixAll": "always"
    },
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.renderSideBySide": true,
    "diffEditor.experimental.showMoves": true,
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[xml]": {
        "editor.defaultFormatter": "redhat.vscode-xml",
        "editor.wordWrap": "off"
    },
    "[markdown]": {
        "editor.defaultFormatter": "yzhang.markdown-all-in-one"
    },
    "markdownlint.config": {
        "no-inline-html": false,
        "no-duplicate-heading": false,
        "no-alt-text": false,
        "heading-increment": false,
        "no-trailing-punctuation": false,
        "ul-indent": false,
        "table-column-style": false,
        "blanks-around-fences": false,
        "first-line-heading": false,
        "single-h1": false
    },
    "markdown-mermaid.mouseNavigation.enabled": "always",
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "js/ts.experimental.useTsgo": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "git.openRepositoryInParentFolders": "always",
    "git.addAICoAuthor": "off",
    "alOutline.codeActionsOnSave": [
        "SortProperties",
        "SortVariables"
    ],
    "alOutline.codeCleanupActions": [
        "RemoveWithStatements",
        "FixKeywordsCase",
        "FixIdentifiersCase",
        "SortProperties",
        "SortVariables",
        "RemoveBeginEnd",
        "RemoveRedundantAppAreas",
        "RemoveRedundantDataClassification",
        "AddMissingParentheses"
    ],
    "alOutline.fixCodeCopMissingParenthesesOnSave": true,
    "alOutline.noEmptyLinesAtTheEndOfWizardGeneratedFiles": true,
    "alOutline.openDefinitionInNewTab": true,
    "alOutline.pageFieldToolTipComment": "de-DE=Gibt den Wert des Feldes %Caption.Comment% an.",
    "alOutline.triggersSortMode": "NaturalOrder",
    "alOutline.addToolTipsToPageFields": false,
    "alCodeActions.initializeIsHandledVariableWhenCreatingOnBeforePublisher": true,
    "alCodeActions.publisherHasVarParametersOnly": true,
    "dotnet.backgroundAnalysis.analyzerDiagnosticsScope": "fullSolution",
    "dotnet.backgroundAnalysis.compilerDiagnosticsScope": "fullSolution",
    "dotnet.formatting.organizeImportsOnFormat": true,
    "csharp.debug.symbolOptions.searchMicrosoftSymbolServer": true,
    "csharp.debug.symbolOptions.searchNuGetOrgSymbolServer": true,
    "csharp.debug.terminateChildProcesses": true,
    "csharp.inlayHints.enableInlayHintsForTypes": true,
    "csharp.inlayHints.enableInlayHintsForImplicitObjectCreation": true,
    "csharp.inlayHints.enableInlayHintsForImplicitVariableTypes": true,
    "csharp.inlayHints.enableInlayHintsForLambdaParameterTypes": true,
    "dotnet.inlayHints.enableInlayHintsForParameters": true,
    "dotnet.inlayHints.enableInlayHintsForIndexerParameters": true,
    "dotnet.inlayHints.enableInlayHintsForLiteralParameters": true,
    "dotnet.inlayHints.enableInlayHintsForObjectCreationParameters": true,
    "dotnet.testWindow.enableNextTest": true,
    "dotnet.testWindow.enableTestExplorerDiff": true,
    "cSpell.language": "en,de",
    "cSpell.dictionaries": [
        "en",
        "de",
        "de-DE"
    ],
    "cSpell.enabledNotifications": {
        "Maximum Word Length Exceeded": false,
        "Lines too Long": false,
        "Average Word Length too Long": false
    },
    "xliffSync.keepEditorOpenAfterSync": false,
    "xliffSync.detectSourceTextChanges": false,
    "xliffSync.parseFromDeveloperNoteOverwrite": true,
    "xliffSync.copyFromSourceOverwrite": true,
    "txtsyntax.associations": [
        ".ini",
        ".cf",
        ".cnf",
        ".conf",
        ".cfg",
        ".unx",
        ".eds",
        ".log",
        ".out",
        ".err",
        ".inf",
        ".info",
        ".tmp",
        ".temp",
        ".file",
        ".repo",
        ".plain",
        ".desktop",
        ".properties",
        ".txt"
    ],
    "codesnap-plus.realLineNumbers": true,
    "codesnap-plus.showWindowControls": false,
    "codesnap-plus.shutterAction": "copy",
    "codesnap-plus.transparentBackground": true,
    "codesnap-plus.target": "window",
    "codesnap-plus.toolMode": "simple",
    "hediet.vscode-drawio.resizeImages": null,
    "terminal.integrated.stickyScroll.enabled": false,
    "security.workspace.trust.enabled": false,
    "redhat.telemetry.enabled": false
}
